{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/api/pwa-icon?size=192"
    },
    {
      "source": "/favicon.png",
      "destination": "/api/pwa-icon?size=192"
    },
    {
      "source": "/favicon-32x32.png",
      "destination": "/api/pwa-icon?size=192"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/api/pwa-icon?size=180"
    },
    {
      "source": "/apple-touch-icon-precomposed.png",
      "destination": "/api/pwa-icon?size=180"
    }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://mmrdpyhoawwoplbzqwag.supabase.co wss://mmrdpyhoawwoplbzqwag.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/stopflow-environment-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "buildCommand": "node scripts/build-pilot.cjs",
  "outputDirectory": ".stopflow-dist",
  "functions": {
    "api/receipt-control-pdf.js": {
      "maxDuration": 60
    },
    "api/document-extraction.js": {
      "maxDuration": 60,
      "includeFiles": [
        "node_modules/tesseract.js/**",
        "node_modules/tesseract.js-core/**",
        "node_modules/@tesseract.js-data/fra/**",
        "stopflow-104-photo-quality.js"
      ]
    }
  }
}
